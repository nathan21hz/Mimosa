[
    {
        "name":"test",
        "type":"static",
        "cron":"*/5 * * * *",
        "startup_data":["", 0],

        "source":{
            "type":"no_auth",
            "url":"https://example.com/api/status",
            "method":"GET",
            "payload":""
        },

        "data":[
            {
                "type":"regexp",
                "exp":"\"title\":\\s*\"(.*?)\"",
                "index":0
            },
            {
                "type":"json",
                "route":["data", "count"]
            }
        ],

        "condition":[
            {
                "conn":"and",
                "var":"$0",
                "op":"!=",
                "target":"#0"
            },
            {
                "conn":"or",
                "var":"$1",
                "op":">=",
                "target":100
            }
        ],

        "push":[{
            "type":"telegram",
            "bot_token":"",
            "to":"",
            "text":"{0}\ncount: {1}"
        }]

    }
]
